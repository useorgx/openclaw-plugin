{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrgX Component Screenshot Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "components", "unmapped"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/definitions/componentEntry" }
    },
    "unmapped": {
      "type": "array",
      "items": { "$ref": "#/definitions/unmappedEntry" }
    }
  },
  "definitions": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "openAction": { "type": "string" },
        "selector": { "type": "string" },
        "withContext": { "type": "boolean" }
      }
    },
    "componentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "componentPath",
        "owner",
        "route",
        "selector",
        "viewports",
        "scenarios",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "componentPath": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "route": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["desktop", "mobile"]
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/scenario" }
        },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["mapped", "unmapped", "disabled"]
        }
      }
    },
    "unmappedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "componentPath", "owner", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "componentPath": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "const": "unmapped" }
      }
    }
  }
}
