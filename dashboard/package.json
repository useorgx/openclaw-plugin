{
  "name": "@orgx/dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true,maxRetries:6,retryDelay:50});\"",
    "build": "npm run clean && node ./node_modules/typescript/lib/tsc.js && node ./node_modules/vite/bin/vite.js build && node ../scripts/compress-dashboard-assets.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.99",
    "@sentry/react": "10.65.0",
    "@sentry/replay": "10.65.0",
