    "@babel/core@>=7 <8": "7.29.6",
    "@opentelemetry/core@>=2 <3": "2.8.0",
    "@protobufjs/utf8@>=1 <2": "1.1.1",
    "baseline-browser-mapping@>=2 <3": "2.11.0",
    "brace-expansion@>=5 <6": "5.0.12",
    "browserslist@>=4 <5": "4.28.7",
    "dompurify@>=3 <4": "3.4.16",
    "fflate@>=0 <1": "0.4.9",
    "nanoid@>=3 <4": "3.3.18",
    "picomatch@>=2 <3": "2.3.2",
