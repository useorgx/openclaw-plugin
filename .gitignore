# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE files
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log
!docs/ops/**/*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# QA capture scratch (mp4/gif are committed; frame directories are not)
docs/qa/**/flow-*-frames/

# QA generated run artifacts (keep docs, ignore heavy generated captures)
docs/qa/components/runs/**
!docs/qa/components/runs/.gitkeep
docs/qa/archive/root-captures/**
!docs/qa/archive/root-captures/README.md

# Generated QA captures (new captures should not be committed by default)
docs/qa/**/*.png
docs/qa/**/*.jpg
docs/qa/**/*.jpeg
docs/qa/**/*.webp
docs/qa/**/*.gif
docs/qa/**/*.mp4
docs/qa/**/*.webm

# Generated run artifacts from targeted verification workflows
docs/run-artifacts/*-targeted-verification-*.md
docs/run-artifacts/*.log
docs/reports/ws*-slice-*-verification-*.md

# Local UI snapshot artifacts
artifacts/**/*.png
artifacts/**/*.jpg
artifacts/**/*.jpeg
artifacts/**/*.webp
artifacts/orgx-design-tokens.json

# Root-level ad hoc captures must stay in docs/qa, not repo root
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.mp4
/*.webm

# Yarn Integrity file
.yarn-integrity

# Local Codex dispatch scratch
.orgx-codex-jobs/

# Local audit/workbench scratch
.tmp-live-audit/

# Local launch/presentation scratch (never commit)
/launch-post.md
/presentation.html
/screenshot-slides.mjs
/screenshots/
/qa/
/tmp/
/scripts/e2e-autopilot-10runs.mjs
